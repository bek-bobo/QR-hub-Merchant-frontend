{
  "name": "qrhub-merchant-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run locales:validate && npm run i18n:boundary && npm run i18n:literals && tsc -b && vite build",
    "lint": "npm run i18n:boundary && npm run i18n:literals && oxlint",
    "typecheck": "npm run locales:validate && tsc -b --pretty false",
    "locales:validate": "node scripts/validate-locales.mjs",
    "locales:generate": "node scripts/validate-locales.mjs --generate",
    "i18n:boundary": "node scripts/check-i18n-boundary.mjs",
    "i18n:literals": "node scripts/check-i18n-literals.mjs",
    "i18n:release-check": "node scripts/i18n-release-check.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/plots": "^2.6.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "i18next": "26.4.2",
    "lucide-react": "1.45.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.0.16",
    "react-router": "8.3.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "20.14.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
